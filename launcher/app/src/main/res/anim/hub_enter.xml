<?xml version="1.0" encoding="utf-8"?>
<!-- Settings page opening (SettingsHubActivity): fades in while growing from 96 %, like a macOS window. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="260">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
